# Copy to .env for local development. Compose sets these per-node itself.

# Identity of this node. Defaults to the hostname (the container id under
# compose), which is usually what you want. Set it explicitly when running
# several nodes by hand on one machine.
# NODE_ID=node-1

DEBUG=1
LOG_LEVEL=INFO
# SECRET_KEY=set-me-in-production
# ALLOWED_HOSTS=localhost,127.0.0.1

REDIS_URL=redis://127.0.0.1:6379/0

# Omit to fall back to sqlite, which is enough for a no-services smoke test.
# Query params pass through to libpq, so managed Postgres keeps its sslmode.
# DATABASE_URL=postgres://connmgr:connmgr@127.0.0.1:5432/connmgr
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Platform-wide ceiling. Per-org limits and reserved floors are Organization
# rows, not settings.
GLOBAL_MAX_SESSIONS=10000

# Liveness. NODE_TIMEOUT_SEC must be a comfortable multiple of HEARTBEAT_SEC:
# too low and a network blip reaps a healthy node, too high and dead nodes hold
# quota. There is no correct value, only a tuned one.
HEARTBEAT_SEC=5
NODE_TIMEOUT_SEC=15
REAP_INTERVAL_SEC=5

# Drain pacing. 0/0 closes every session at once on SIGTERM. Raise these to
# spread reconnects and avoid stampeding the surviving nodes.
DRAIN_BATCH_SIZE=0
DRAIN_INTERVAL_MS=0
